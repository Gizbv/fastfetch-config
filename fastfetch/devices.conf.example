# ============================================================
# УСТРОЙСТВА
# ============================================================
#
# Этот файл содержит только названия и идентификаторы
# оборудования, используемые config.jsonc.
#
# Формат: shell-переменные.
# Файл подключается через source из config.jsonc.
#
# Скопируйте этот файл в devices.conf и измените значения
# под своё оборудование.
#
# Логику вывода в config.jsonc менять не требуется.
#
# Динамические показатели системы (диски и память)
# здесь НЕ хранятся.


# ─────────────────────────── ДИСПЛЕИ ───────────────────────────

# Имя монитора, отображаемое в FastFetch.
MONITOR_1="Monitor 1"

# Физический видеовыход, к которому подключён монитор.
# Проверить можно через: kscreen-doctor -o
MONITOR_1_PORT="DP-1"

# Резервное разрешение, используемое если FastFetch
# не сможет получить режим непосредственно из DRM.
MONITOR_1_FALLBACK_MODE="1920x1080"

# Физический размер и частота обновления.
MONITOR_1_SIZE='24"'
MONITOR_1_REFRESH='60 Hz'


MONITOR_2="Monitor 2"
MONITOR_2_PORT="DP-2"

MONITOR_2_FALLBACK_MODE="1920x1080"

MONITOR_2_SIZE='24"'
MONITOR_2_REFRESH='60 Hz'


# ─────────────────────────── ПЕРИФЕРИЯ ────────────────────────

# Название мыши и её USB VID:PID.
# Проверить можно через: lsusb
MOUSE="My Mouse"
MOUSE_ID="0000:0000"

# Название клавиатуры и её USB VID:PID.
# Проверить можно через: lsusb
KEYBOARD="My Keyboard"
KEYBOARD_ID="0000:0000"


# ───────────────────────────── АУДИО ───────────────────────────
#
# USB VID:PID можно посмотреть командой: lsusb
# В PipeWire/WirePlumber сопоставление выполняется
# по параметру alsa.components.

# Название наушников и USB VID:PID.
HEADPHONES="My Headphones"
HEADPHONES_ID="0000:0000"

# Название колонок и USB VID:PID.
SPEAKERS="My Speakers"
SPEAKERS_ID="0000:0000"

# Название микрофона и USB VID:PID.
MICROPHONE="My Microphone"
MICROPHONE_ID="0000:0000"


# ───────────────────────────── ПАМЯТЬ ──────────────────────────

# Модель и характеристики установленной оперативной памяти.
MEMORY="32 GiB DDR4-3200"
